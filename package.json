{
  "name": "personal-web-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "WORKSPACE_TEST=1 node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-workspace \"npm test\"",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "flexsearch": "^0.8.212",
    "hash-wasm": "^4.12.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
