rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAllowlistedDomain() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        (request.auth.token.email.matches('.*@rfnsyhmi\\.dpdns\\.org') ||
         request.auth.token.email.matches('.*@kitabuddy\\.dpdns\\.org') ||
         request.auth.token.email == 'rfnsyhmi.principal@gmail.com' ||
         request.auth.token.email == 'm-10531068@moe-dl.edu.my');
    }
    function hasDocumentAccess(docData) {
      return isAllowlistedDomain() && 
        (docData.ownerId == request.auth.uid || request.auth.uid in docData.sharedWith);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isAllowlistedDomain();
    }
    match /documents/{docId} {
      allow create: if isAllowlistedDomain() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if hasDocumentAccess(resource.data);
    }
    match /annotations/{annotationId} {
      allow create: if isAllowlistedDomain();
      allow read, update, delete: if isAllowlistedDomain();
    }
    match /notes/{noteId} {
      allow create: if isAllowlistedDomain();
      allow read, update, delete: if isAllowlistedDomain();
      
      match /deltas/{deltaId} {
        allow read, write: if isAllowlistedDomain();
      }
    }
  }
}
